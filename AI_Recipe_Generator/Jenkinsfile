pipeline {
    agent any

    environment {
        IMAGE_NAME     = "ai-recipe-generator"
        IMAGE_TAG      = "${BUILD_NUMBER}"
        DOCKERHUB_REPO = "vijayan017/ai-recipe-generator"
        DOCKERHUB_CRED = "dockerhub-credentials"
        CONTAINER_NAME = "ai-recipe-generator-app"

        PYTHON_EXE = "C:\\Users\\Vijayan\\AppData\\Local\\Python\\bin\\python.exe"
    }

    stages {

        /*
         * Jenkins automatically checks out the repository
         * because this is a Pipeline job connected to SCM.
         */

        stage('Check Tools') {
            steps {
                bat '''
                    echo ==============================
                    echo CHECKING PYTHON
                    echo ==============================

                    "%PYTHON_EXE%" --version

                    echo.
                    echo ==============================
                    echo CHECKING GIT
                    echo ==============================

                    git --version

                    echo.
                    echo ==============================
                    echo CHECKING DOCKER
                    echo ==============================

                    docker --version

                    echo.
                    echo ==============================
                    echo CHECKING DOCKER ENGINE
                    echo ==============================

                    docker info >nul 2>&1

                    if %ERRORLEVEL% NEQ 0 (
                        echo Docker Desktop is not running.
                        exit /b 1
                    )

                    echo Docker is running successfully.
                '''
            }
        }

        stage('Set Up Python') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==============================
                        echo SETTING UP PYTHON
                        echo ==============================

                        if exist venv (
                            echo Virtual environment already exists.
                        ) else (
                            echo Creating virtual environment...
                            "%PYTHON_EXE%" -m venv venv
                        )

                        echo.
                        echo Upgrading pip...

                        venv\\Scripts\\python.exe -m pip install --upgrade pip

                        echo.
                        echo Installing requirements...

                        venv\\Scripts\\python.exe -m pip install -r requirements.txt

                        echo.
                        echo Python setup completed.
                    '''
                }
            }
        }

        stage('Lint / Basic Checks') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==============================
                        echo LINT CHECK
                        echo ==============================

                        venv\\Scripts\\python.exe -m pip install flake8

                        venv\\Scripts\\python.exe -m flake8 . --max-line-length=120 --exclude=venv

                        if %ERRORLEVEL% NEQ 0 (
                            echo.
                            echo Flake8 found warnings/errors.
                            echo Continuing pipeline because lint is non-blocking.
                            exit /b 0
                        )

                        echo Lint completed successfully.
                    '''
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==============================
                        echo RUNNING TESTS
                        echo ==============================

                        venv\\Scripts\\python.exe -m pip install pytest

                        venv\\Scripts\\python.exe -m pytest

                        if %ERRORLEVEL% NEQ 0 (
                            echo.
                            echo No tests found or tests failed.
                            echo Continuing pipeline because tests are currently non-blocking.
                            exit /b 0
                        )

                        echo Tests completed successfully.
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==============================
                        echo BUILDING DOCKER IMAGE
                        echo ==============================

                        docker build ^
                            -t %DOCKERHUB_REPO%:%IMAGE_TAG% ^
                            -t %DOCKERHUB_REPO%:latest ^
                            .

                        if %ERRORLEVEL% NEQ 0 (
                            echo Docker image build failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker image built successfully.

                        echo.
                        echo Available images:

                        docker images %DOCKERHUB_REPO%
                    '''
                }
            }
        }

        stage('Push to DockerHub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKERHUB_CRED}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    bat '''
                        echo ==============================
                        echo DOCKER HUB LOGIN
                        echo ==============================

                        echo %DOCKER_PASSWORD% | docker login -u %DOCKER_USERNAME% --password-stdin

                        if %ERRORLEVEL% NEQ 0 (
                            echo Docker Hub login failed.
                            exit /b 1
                        )

                        echo.
                        echo ==============================
                        echo PUSHING VERSIONED IMAGE
                        echo ==============================

                        docker push %DOCKERHUB_REPO%:%IMAGE_TAG%

                        if %ERRORLEVEL% NEQ 0 (
                            echo Failed to push versioned image.
                            docker logout
                            exit /b 1
                        )

                        echo.
                        echo ==============================
                        echo PUSHING LATEST IMAGE
                        echo ==============================

                        docker push %DOCKERHUB_REPO%:latest

                        if %ERRORLEVEL% NEQ 0 (
                            echo Failed to push latest image.
                            docker logout
                            exit /b 1
                        )

                        echo.
                        echo Docker images pushed successfully.

                        docker logout
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                bat '''
                    echo ==============================
                    echo DEPLOYING APPLICATION
                    echo ==============================

                    echo.
                    echo Stopping old container...

                    docker stop %CONTAINER_NAME% >nul 2>&1

                    echo.
                    echo Removing old container...

                    docker rm %CONTAINER_NAME% >nul 2>&1

                    echo.
                    echo Starting new container...

                    docker run -d ^
                        --name %CONTAINER_NAME% ^
                        -p 5000:5000 ^
                        %DOCKERHUB_REPO%:%IMAGE_TAG%

                    if %ERRORLEVEL% NEQ 0 (
                        echo Docker container failed to start.
                        exit /b 1
                    )

                    echo.
                    echo ==============================
                    echo CONTAINER RUNNING
                    echo ==============================

                    docker ps

                    echo.
                    echo ==============================
                    echo APPLICATION
                    echo ==============================

                    echo Application URL:
                    echo http://localhost:5000
                '''
            }
        }
    }

    post {

        success {
            echo "=========================================="
            echo "BUILD SUCCESSFUL"
            echo "=========================================="
            echo "Build Number : ${BUILD_NUMBER}"
            echo "Docker Image : ${DOCKERHUB_REPO}:${IMAGE_TAG}"
            echo "Container    : ${CONTAINER_NAME}"
            echo "Application  : http://localhost:5000"
            echo "=========================================="
        }

        failure {
            echo "=========================================="
            echo "BUILD FAILED"
            echo "=========================================="
            echo "Build #${BUILD_NUMBER} failed."
            echo "Check the stage that failed above."
            echo "=========================================="
        }

        always {
            echo "Pipeline execution completed."
        }
    }
}