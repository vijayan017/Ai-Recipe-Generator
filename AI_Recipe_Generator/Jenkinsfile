pipeline {

    agent any

    environment {
        DOCKER_IMAGE = 'vijayan12/ai-recipe-generator'
        DOCKER_CREDENTIALS = 'dockerhub-credentials'
        CONTAINER_NAME = 'ai-recipe-generator'
        APP_PORT = '5000'
        PYTHON = 'C:\\Users\\Vijayan\\AppData\\Local\\Python\\bin\\python.exe'
    }

    stages {

        // ==========================================
        // 1. CHECK TOOLS
        // ==========================================
        stage('Check Tools') {
            steps {
                bat '''
                    echo ==============================
                    echo CHECKING PYTHON
                    echo ==============================
                    "%PYTHON%" --version

                    echo.
                    echo ==============================
                    echo CHECKING GIT
                    echo ==============================
                    "C:\\Program Files\\Git\\cmd\\git.exe" --version

                    echo.
                    echo ==============================
                    echo CHECKING DOCKER
                    echo ==============================
                    docker --version

                    echo.
                    echo ==============================
                    echo CHECKING DOCKER ENGINE
                    echo ==============================
                    docker info >nul 2>&1

                    if %ERRORLEVEL% NEQ 0 (
                        echo Docker Desktop is not running.
                        exit /b 1
                    )

                    echo Docker is running successfully.
                '''
            }
        }

        // ==========================================
        // 2. SET UP PYTHON
        // ==========================================
        stage('Set Up Python') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==============================
                        echo SETTING UP PYTHON
                        echo ==============================
                        
                        if exist venv (
                            echo Virtual environment already exists.
                        ) else (
                            echo Creating virtual environment...
                            "%PYTHON%" -m venv venv
                        )

                        echo.
                        echo Upgrading pip...
                        venv\\Scripts\\python.exe -m pip install --upgrade pip

                        echo.
                        echo Installing requirements...
                        venv\\Scripts\\python.exe -m pip install -r requirements.txt

                        echo.
                        echo Python setup completed.
                    '''
                }
            }
        }

        // ==========================================
        // 3. LINT / BASIC CHECKS
        // ==========================================
        stage('Lint / Basic Checks') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==============================
                        echo LINT CHECK
                        echo ==============================

                        venv\\Scripts\\python.exe -m pip install flake8

                        venv\\Scripts\\python.exe -m flake8 . --max-line-length=120 --exclude=venv

                        if %ERRORLEVEL% NEQ 0 (
                            echo.
                            echo Flake8 found warnings/errors.
                            echo Continuing pipeline because lint is non-blocking.
                            exit /b 0
                        )

                        echo Lint check completed successfully.
                    '''
                }
            }
        }

        // ==========================================
        // 4. RUN TESTS
        // ==========================================
        stage('Run Tests') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==============================
                        echo RUNNING TESTS
                        echo ==============================

                        venv\\Scripts\\python.exe -m pip install pytest

                        venv\\Scripts\\python.exe -m pytest

                        if %ERRORLEVEL% NEQ 0 (
                            echo.
                            echo No tests found or tests failed.
                            echo Continuing pipeline because tests are currently non-blocking.
                            exit /b 0
                        )

                        echo Tests completed successfully.
                    '''
                }
            }
        }

        // ==========================================
        // 5. BUILD DOCKER IMAGE
        // ==========================================
        stage('Build Docker Image') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==============================
                        echo BUILDING DOCKER IMAGE
                        echo ==============================

                        docker build ^
                            -t %DOCKER_IMAGE%:%BUILD_NUMBER% ^
                            -t %DOCKER_IMAGE%:latest ^
                            .

                        if %ERRORLEVEL% NEQ 0 (
                            echo Docker image build failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker image built successfully.

                        echo.
                        echo Available images:
                        docker images %DOCKER_IMAGE%
                    '''
                }
            }
        }

        // ==========================================
        // 6. PUSH TO DOCKER HUB
        // ==========================================
        stage('Push to DockerHub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDENTIALS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    bat '''
                        echo ==============================
                        echo DOCKER HUB LOGIN
                        echo ==============================

                        echo %DOCKER_PASSWORD% | docker login -u %DOCKER_USERNAME% --password-stdin

                        if %ERRORLEVEL% NEQ 0 (
                            echo Docker Hub login failed.
                            exit /b 1
                        )

                        echo Docker Hub login successful.

                        echo.
                        echo ==============================
                        echo PUSHING VERSION IMAGE
                        echo ==============================

                        docker push %DOCKER_IMAGE%:%BUILD_NUMBER%

                        if %ERRORLEVEL% NEQ 0 (
                            echo Failed to push version image.
                            exit /b 1
                        )

                        echo.
                        echo ==============================
                        echo PUSHING LATEST IMAGE
                        echo ==============================

                        docker push %DOCKER_IMAGE%:latest

                        if %ERRORLEVEL% NEQ 0 (
                            echo Failed to push latest image.
                            exit /b 1
                        )

                        echo.
                        echo Docker images pushed successfully.
                    '''
                }
            }
        }

        // ==========================================
        // 7. DEPLOY
        // ==========================================
        stage('Deploy') {
            steps {
                bat '''
                    echo ==============================
                    echo DEPLOYING APPLICATION
                    echo ==============================

                    echo Stopping old container if it exists...

                    docker stop %CONTAINER_NAME% >nul 2>&1

                    echo Removing old container if it exists...

                    docker rm %CONTAINER_NAME% >nul 2>&1

                    echo.
                    echo Starting new container...

                    docker run -d ^
                        --name %CONTAINER_NAME% ^
                        -p %APP_PORT%:%APP_PORT% ^
                        %DOCKER_IMAGE%:latest

                    if %ERRORLEVEL% NEQ 0 (
                        echo Docker container deployment failed.
                        exit /b 1
                    )

                    echo.
                    echo ==============================
                    echo DEPLOYMENT SUCCESSFUL
                    echo ==============================

                    echo.
                    echo Running containers:
                    docker ps

                    echo.
                    echo Application available at:
                    echo http://localhost:%APP_PORT%
                '''
            }
        }
    }

    // ==========================================
    // POST ACTIONS
    // ==========================================
    post {

        success {
            echo '=========================================='
            echo 'BUILD SUCCESSFUL'
            echo '=========================================='
            echo "Build #${BUILD_NUMBER} completed successfully."
            echo "Docker image: ${DOCKER_IMAGE}:${BUILD_NUMBER}"
            echo "Docker image: ${DOCKER_IMAGE}:latest"
            echo "Application: http://localhost:${APP_PORT}"
            echo '=========================================='
        }

        failure {
            echo '=========================================='
            echo 'BUILD FAILED'
            echo '=========================================='
            echo "Build #${BUILD_NUMBER} failed."
            echo 'Check the stage that failed above.'
            echo '=========================================='
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}