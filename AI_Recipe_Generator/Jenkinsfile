pipeline {

    agent any

    environment {
        DOCKER_IMAGE = 'vijayan12/ai-recipe-generator'
        CONTAINER_NAME = 'ai-recipe-generator'
        PYTHON = 'C:\\Users\\Vijayan\\AppData\\Local\\Python\\bin\\python.exe'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '=========================================='
                echo 'CHECKING OUT SOURCE CODE'
                echo '=========================================='
                echo 'Source code obtained from GitHub.'
            }
        }


        stage('Check Tools') {
            steps {
                bat '''
                    echo ==============================
                    echo CHECKING PYTHON
                    echo ==============================

                    "%PYTHON%" --version

                    if %ERRORLEVEL% NEQ 0 (
                        echo Python is not installed or path is incorrect.
                        exit /b 1
                    )

                    echo.
                    echo ==============================
                    echo CHECKING GIT
                    echo ==============================

                    git --version

                    if %ERRORLEVEL% NEQ 0 (
                        echo Git is not installed.
                        exit /b 1
                    )

                    echo.
                    echo ==============================
                    echo CHECKING DOCKER
                    echo ==============================

                    docker --version

                    if %ERRORLEVEL% NEQ 0 (
                        echo Docker is not installed.
                        exit /b 1
                    )

                    echo.
                    echo ==============================
                    echo CHECKING DOCKER ENGINE
                    echo ==============================

                    docker info >nul 2>&1

                    if %ERRORLEVEL% NEQ 0 (
                        echo Docker Desktop is not running.
                        exit /b 1
                    )

                    echo Docker Engine is running successfully.
                '''
            }
        }


        stage('Set Up Python') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==============================
                        echo SETTING UP PYTHON
                        echo ==============================

                        if exist venv (
                            echo Virtual environment already exists.
                        ) else (
                            echo Creating virtual environment...

                            "%PYTHON%" -m venv venv

                            if %ERRORLEVEL% NEQ 0 (
                                echo Failed to create virtual environment.
                                exit /b 1
                            )
                        )

                        echo.
                        echo Upgrading pip...

                        venv\\Scripts\\python.exe -m pip install --upgrade pip

                        if %ERRORLEVEL% NEQ 0 (
                            echo Pip upgrade failed.
                            exit /b 1
                        )

                        echo.
                        echo Installing project requirements...

                        venv\\Scripts\\python.exe -m pip install -r requirements.txt

                        if %ERRORLEVEL% NEQ 0 (
                            echo Requirements installation failed.
                            exit /b 1
                        )

                        echo.
                        echo Python setup completed successfully.
                    '''
                }
            }
        }


        stage('Lint / Basic Checks') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==============================
                        echo LINT CHECK
                        echo ==============================

                        venv\\Scripts\\python.exe -m pip install flake8

                        venv\\Scripts\\python.exe -m flake8 . --max-line-length=120 --exclude=venv

                        if %ERRORLEVEL% NEQ 0 (
                            echo.
                            echo Flake8 found warnings/errors.
                            echo Continuing because lint is non-blocking.
                            exit /b 0
                        )

                        echo.
                        echo Lint completed successfully.
                    '''
                }
            }
        }


        stage('Run Tests') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==============================
                        echo RUNNING TESTS
                        echo ==============================

                        venv\\Scripts\\python.exe -m pip install pytest

                        venv\\Scripts\\python.exe -m pytest

                        if %ERRORLEVEL% NEQ 0 (
                            echo.
                            echo No tests found or tests failed.
                            echo Continuing because tests are non-blocking.
                            exit /b 0
                        )

                        echo.
                        echo Tests completed successfully.
                    '''
                }
            }
        }


        stage('Build Docker Image') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==============================
                        echo BUILDING DOCKER IMAGE
                        echo ==============================

                        docker build -t %DOCKER_IMAGE%:%BUILD_NUMBER% -t %DOCKER_IMAGE%:latest .

                        if %ERRORLEVEL% NEQ 0 (
                            echo Docker image build failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker image built successfully.

                        echo.
                        echo ==============================
                        echo DOCKER IMAGES
                        echo ==============================

                        docker images %DOCKER_IMAGE%
                    '''
                }
            }
        }


        stage('Check Docker Login') {
            steps {
                bat '''
                    echo ==============================
                    echo CHECKING DOCKER HUB LOGIN
                    echo ==============================

                    docker info

                    echo.
                    echo Docker credentials will be used from
                    echo the Windows account running Jenkins.
                    echo.
                '''
            }
        }


        stage('Push to DockerHub') {
            steps {
                bat '''
                    echo ==============================
                    echo PUSHING VERSION IMAGE
                    echo ==============================

                    docker push %DOCKER_IMAGE%:%BUILD_NUMBER%

                    if %ERRORLEVEL% NEQ 0 (
                        echo.
                        echo Docker Hub push failed.
                        echo Make sure Jenkins is running under
                        echo the Windows account that has Docker login.
                        exit /b 1
                    )

                    echo.
                    echo Version image pushed successfully.

                    echo.
                    echo ==============================
                    echo PUSHING LATEST IMAGE
                    echo ==============================

                    docker push %DOCKER_IMAGE%:latest

                    if %ERRORLEVEL% NEQ 0 (
                        echo.
                        echo Latest image push failed.
                        exit /b 1
                    )

                    echo.
                    echo ==============================
                    echo DOCKER HUB PUSH SUCCESSFUL
                    echo ==============================

                    echo Version:
                    echo %DOCKER_IMAGE%:%BUILD_NUMBER%

                    echo Latest:
                    echo %DOCKER_IMAGE%:latest
                '''
            }
        }


        stage('Deploy') {
            steps {
                bat '''
                    echo ==============================
                    echo DEPLOYING APPLICATION
                    echo ==============================

                    echo.
                    echo Removing old container if it exists...

                    docker rm -f %CONTAINER_NAME% >nul 2>&1

                    echo.
                    echo Pulling latest Docker image...

                    docker pull %DOCKER_IMAGE%:latest

                    if %ERRORLEVEL% NEQ 0 (
                        echo Docker image pull failed.
                        exit /b 1
                    )

                    echo.
                    echo Starting new container...

                    docker run -d ^
                        --name %CONTAINER_NAME% ^
                        -p 5000:5000 ^
                        --restart unless-stopped ^
                        %DOCKER_IMAGE%:latest

                    if %ERRORLEVEL% NEQ 0 (
                        echo Docker container failed to start.
                        exit /b 1
                    )

                    echo.
                    echo ==============================
                    echo DEPLOYMENT SUCCESSFUL
                    echo ==============================

                    echo.
                    echo Container status:

                    docker ps --filter "name=%CONTAINER_NAME%"

                    echo.
                    echo Application URL:
                    echo http://localhost:5000
                '''
            }
        }
    }


    post {

        success {
            echo """
==========================================
PIPELINE SUCCESSFUL
==========================================

Build Number:
${BUILD_NUMBER}

Docker Image:
vijayan12/ai-recipe-generator:${BUILD_NUMBER}

Latest Image:
vijayan12/ai-recipe-generator:latest

Application:
http://localhost:5000

==========================================
"""
        }

        failure {
            echo """
==========================================
PIPELINE FAILED
==========================================

Build Number:
${BUILD_NUMBER}

Check the failed stage in the console output.

==========================================
"""
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}