pipeline {

    agent any

    environment {
        DOCKER_IMAGE = "vijayan12/ai-recipe-generator"
        CONTAINER_NAME = "ai-recipe-generator"
        PYTHON = "C:\\Users\\Vijayan\\AppData\\Local\\Python\\bin\\python.exe"
    }

    stages {

        // ============================================================
        // CHECK TOOLS
        // ============================================================

        stage('Check Tools') {
            steps {
                bat '''
                    echo ==============================
                    echo CHECKING PYTHON
                    echo ==============================

                    "%PYTHON%" --version

                    if %ERRORLEVEL% NEQ 0 (
                        echo Python is not installed or path is incorrect.
                        exit /b 1
                    )

                    echo.
                    echo ==============================
                    echo CHECKING GIT
                    echo ==============================

                    "C:\\Program Files\\Git\\cmd\\git.exe" --version

                    if %ERRORLEVEL% NEQ 0 (
                        echo Git is not installed.
                        exit /b 1
                    )

                    echo.
                    echo ==============================
                    echo CHECKING DOCKER
                    echo ==============================

                    docker --version

                    if %ERRORLEVEL% NEQ 0 (
                        echo Docker is not installed.
                        exit /b 1
                    )

                    echo.
                    echo ==============================
                    echo CHECKING DOCKER ENGINE
                    echo ==============================

                    docker info >nul 2>&1

                    if %ERRORLEVEL% NEQ 0 (
                        echo Docker Desktop is not running.
                        exit /b 1
                    )

                    echo Docker is running successfully.
                '''
            }
        }


        // ============================================================
        // SETUP PYTHON
        // ============================================================

        stage('Set Up Python') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==============================
                        echo SETTING UP PYTHON
                        echo ==============================

                        if exist venv (
                            echo Virtual environment already exists.
                        ) else (
                            echo Creating virtual environment...
                            "%PYTHON%" -m venv venv

                            if %ERRORLEVEL% NEQ 0 (
                                echo Failed to create virtual environment.
                                exit /b 1
                            )
                        )

                        echo.
                        echo Upgrading pip...

                        venv\\Scripts\\python.exe -m pip install --upgrade pip

                        if %ERRORLEVEL% NEQ 0 (
                            echo Pip upgrade failed.
                            exit /b 1
                        )

                        echo.
                        echo Installing requirements...

                        venv\\Scripts\\python.exe -m pip install -r requirements.txt

                        if %ERRORLEVEL% NEQ 0 (
                            echo Requirements installation failed.
                            exit /b 1
                        )

                        echo.
                        echo Python setup completed.
                    '''
                }
            }
        }


        // ============================================================
        // LINT
        // ============================================================

        stage('Lint / Basic Checks') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==============================
                        echo LINT CHECK
                        echo ==============================

                        venv\\Scripts\\python.exe -m pip install flake8

                        venv\\Scripts\\python.exe -m flake8 . --max-line-length=120 --exclude=venv

                        if %ERRORLEVEL% NEQ 0 (
                            echo.
                            echo Flake8 found warnings/errors.
                            echo Continuing because lint is non-blocking.
                            exit /b 0
                        )

                        echo.
                        echo Lint check completed successfully.
                    '''
                }
            }
        }


        // ============================================================
        // TESTS
        // ============================================================

        stage('Run Tests') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==============================
                        echo RUNNING TESTS
                        echo ==============================

                        venv\\Scripts\\python.exe -m pip install pytest

                        venv\\Scripts\\python.exe -m pytest

                        if %ERRORLEVEL% NEQ 0 (
                            echo.
                            echo No tests found or tests failed.
                            echo Continuing because tests are currently non-blocking.
                            exit /b 0
                        )

                        echo.
                        echo Tests completed successfully.
                    '''
                }
            }
        }


        // ============================================================
        // BUILD DOCKER IMAGE
        // ============================================================

        stage('Build Docker Image') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==============================
                        echo BUILDING DOCKER IMAGE
                        echo ==============================

                        docker build ^
                            -t %DOCKER_IMAGE%:%BUILD_NUMBER% ^
                            -t %DOCKER_IMAGE%:latest ^
                            .

                        if %ERRORLEVEL% NEQ 0 (
                            echo Docker image build failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker image built successfully.

                        echo.
                        echo ==============================
                        echo AVAILABLE IMAGES
                        echo ==============================

                        docker images %DOCKER_IMAGE%
                    '''
                }
            }
        }


        // ============================================================
        // DOCKER HUB LOGIN + PUSH
        // ============================================================

        stage('Push to DockerHub') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    bat '''
                        echo ==============================
                        echo DOCKER HUB LOGIN
                        echo ==============================

                        echo %DOCKER_PASSWORD% | docker login -u %DOCKER_USERNAME% --password-stdin

                        if %ERRORLEVEL% NEQ 0 (
                            echo.
                            echo Docker Hub login failed.
                            echo Check Jenkins credential:
                            echo dockerhub-credentials
                            exit /b 1
                        )

                        echo.
                        echo Docker Hub login successful.

                        echo.
                        echo ==============================
                        echo PUSHING VERSION IMAGE
                        echo ==============================

                        docker push %DOCKER_IMAGE%:%BUILD_NUMBER%

                        if %ERRORLEVEL% NEQ 0 (
                            echo Version image push failed.
                            exit /b 1
                        )

                        echo.
                        echo ==============================
                        echo PUSHING LATEST IMAGE
                        echo ==============================

                        docker push %DOCKER_IMAGE%:latest

                        if %ERRORLEVEL% NEQ 0 (
                            echo Latest image push failed.
                            exit /b 1
                        )

                        echo.
                        echo ==============================
                        echo DOCKER PUSH SUCCESSFUL
                        echo ==============================

                        echo Version:
                        echo %DOCKER_IMAGE%:%BUILD_NUMBER%

                        echo Latest:
                        echo %DOCKER_IMAGE%:latest

                        echo.
                        docker logout
                    '''
                }
            }
        }


        // ============================================================
        // DEPLOY
        // ============================================================

        stage('Deploy') {
            steps {
                bat '''
                    echo ==============================
                    echo DEPLOYING APPLICATION
                    echo ==============================

                    echo Checking existing container...

                    for /f "tokens=*" %%i in ('docker ps -aq -f "name=^%CONTAINER_NAME%$"') do (
                        echo Removing existing container %%i
                        docker rm -f %%i
                    )

                    echo.
                    echo Pulling latest image...

                    docker pull %DOCKER_IMAGE%:latest

                    if %ERRORLEVEL% NEQ 0 (
                        echo Failed to pull Docker image.
                        exit /b 1
                    )

                    echo.
                    echo Starting new container...

                    docker run -d ^
                        --name %CONTAINER_NAME% ^
                        -p 5000:5000 ^
                        --restart unless-stopped ^
                        %DOCKER_IMAGE%:latest

                    if %ERRORLEVEL% NEQ 0 (
                        echo Failed to start Docker container.
                        exit /b 1
                    )

                    echo.
                    echo ==============================
                    echo DEPLOYMENT SUCCESSFUL
                    echo ==============================

                    echo.
                    echo Container:
                    docker ps --filter "name=%CONTAINER_NAME%"

                    echo.
                    echo Application URL:
                    echo http://localhost:5000
                '''
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {
            echo '''
==========================================
BUILD SUCCESSFUL
==========================================
Build #${BUILD_NUMBER} completed successfully.

Docker Image:
vijayan12/ai-recipe-generator:${BUILD_NUMBER}

Latest Image:
vijayan12/ai-recipe-generator:latest

Application:
http://localhost:5000
==========================================
'''
        }

        failure {
            echo '''
==========================================
BUILD FAILED
==========================================
Build #${BUILD_NUMBER} failed.
Check the stage that failed above.
==========================================
'''
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}