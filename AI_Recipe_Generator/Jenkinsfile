pipeline {
    agent any

    environment {
        PYTHON = 'C:\\Users\\Vijayan\\AppData\\Local\\Python\\bin\\python.exe'
        GIT = 'C:\\Program Files\\Git\\cmd\\git.exe'

        DOCKER_IMAGE = 'vijayan12/ai-recipe-generator'
        APP_NAME = 'ai-recipe-generator'
        APP_PORT = '5000'
        HOST_PORT = '5000'
    }

    stages {

        stage('Check Tools') {
            steps {
                echo 'Checking required tools...'

                bat '''
                    echo Checking Python...
                    "%PYTHON%" --version

                    echo.
                    echo Checking Git...
                    "%GIT%" --version

                    echo.
                    echo Checking Docker...
                    docker --version

                    echo.
                    echo Checking Docker Engine...
                    docker info
                '''
            }
        }

        stage('Set Up Python') {
            steps {
                echo 'Setting up Python environment...'

                bat '''
                    if not exist venv (
                        "%PYTHON%" -m venv venv
                    )

                    call venv\\Scripts\\activate.bat

                    python --version
                    python -m pip install --upgrade pip

                    if exist requirements.txt (
                        python -m pip install -r requirements.txt
                    ) else (
                        echo requirements.txt not found!
                        exit /b 1
                    )
                '''
            }
        }

        stage('Lint / Basic Checks') {
            steps {
                echo 'Running basic code checks...'

                bat '''
                    call venv\\Scripts\\activate.bat

                    python -m pip install flake8

                    flake8 . --exclude=venv,__pycache__,.git --count --statistics || echo Flake8 warnings found - continuing pipeline.
                '''
            }
        }

        stage('Run Tests') {
            steps {
                echo 'Running tests...'

                bat '''
                    call venv\\Scripts\\activate.bat

                    python -m pip install pytest

                    if exist tests (
                        pytest -v
                    ) else (
                        echo No tests directory found.
                        echo Skipping pytest.
                    )
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'

                bat '''
                    docker build -t %DOCKER_IMAGE%:%BUILD_NUMBER% .
                    docker tag %DOCKER_IMAGE%:%BUILD_NUMBER% %DOCKER_IMAGE%:latest

                    echo.
                    echo Docker images created:
                    docker images %DOCKER_IMAGE%
                '''
            }
        }

        stage('Login to DockerHub') {
            steps {
                echo 'Logging in to Docker Hub...'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    bat '''
                        echo %DOCKER_PASSWORD% | docker login ^
                            -u %DOCKER_USERNAME% ^
                            --password-stdin
                    '''
                }
            }
        }

        stage('Push to DockerHub') {
            steps {
                echo 'Pushing Docker image to Docker Hub...'

                bat '''
                    docker push %DOCKER_IMAGE%:%BUILD_NUMBER%
                    docker push %DOCKER_IMAGE%:latest
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying AI Recipe Generator container...'

                bat '''
                    echo Stopping existing container...

                    docker stop %APP_NAME% >nul 2>&1 || echo No running container found.

                    echo Removing existing container...

                    docker rm %APP_NAME% >nul 2>&1 || echo No existing container found.

                    echo Pulling latest image...

                    docker pull %DOCKER_IMAGE%:latest

                    echo Starting new container...

                    docker run -d ^
                        --name %APP_NAME% ^
                        -p %HOST_PORT%:%APP_PORT% ^
                        %DOCKER_IMAGE%:latest

                    echo.
                    echo Container started successfully.

                    docker ps
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                echo 'Verifying Docker container...'

                bat '''
                    timeout /t 10 /nobreak >nul

                    echo.
                    echo Container status:
                    docker ps --filter "name=%APP_NAME%"

                    echo.
                    echo Container logs:
                    docker logs %APP_NAME% --tail 30

                    echo.
                    echo Checking application port...
                    powershell -Command "try { $r = Invoke-WebRequest -Uri http://localhost:%HOST_PORT% -UseBasicParsing -TimeoutSec 10; Write-Host ('HTTP Status: ' + $r.StatusCode) } catch { Write-Host ('Application check: ' + $_.Exception.Message) }"
                '''
            }
        }
    }

    post {
        success {
            echo '========================================'
            echo 'PIPELINE COMPLETED SUCCESSFULLY'
            echo '========================================'
            echo 'AI Recipe Generator is deployed.'
            echo 'Application URL: http://localhost:5000'
        }

        failure {
            echo '========================================'
            echo 'PIPELINE FAILED'
            echo '========================================'
            echo 'Please check the Jenkins console output.'
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}

