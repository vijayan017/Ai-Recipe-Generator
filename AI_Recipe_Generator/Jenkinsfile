```groovy
pipeline {
    agent any

    environment {
        PYTHON = 'C:\\Users\\Vijayan\\AppData\\Local\\Python\\bin\\python.exe'
        GIT = 'C:\\Program Files\\Git\\cmd\\git.exe'

        DOCKER_IMAGE = 'vijayan12/ai-recipe-generator'

        APP_NAME = 'ai-recipe-generator'
        APP_PORT = '5000'
        HOST_PORT = '5000'
    }

    stages {

        stage('Check Tools') {
            steps {
                bat '''
                    echo ==========================================
                    echo CHECKING PYTHON
                    echo ==========================================
                    "%PYTHON%" --version

                    if %ERRORLEVEL% NEQ 0 (
                        echo Python is not installed or path is incorrect.
                        exit /b 1
                    )

                    echo ==========================================
                    echo CHECKING GIT
                    echo ==========================================
                    "%GIT%" --version

                    if %ERRORLEVEL% NEQ 0 (
                        echo Git is not installed or path is incorrect.
                        exit /b 1
                    )

                    echo ==========================================
                    echo CHECKING DOCKER
                    echo ==========================================
                    docker --version

                    if %ERRORLEVEL% NEQ 0 (
                        echo Docker is not installed.
                        exit /b 1
                    )

                    echo ==========================================
                    echo CHECKING DOCKER ENGINE
                    echo ==========================================
                    docker info >nul 2>&1

                    if %ERRORLEVEL% NEQ 0 (
                        echo Docker Desktop is not running.
                        exit /b 1
                    )

                    echo ALL TOOLS ARE READY
                '''
            }
        }

        stage('Set Up Python') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==========================================
                        echo SETTING UP PYTHON
                        echo ==========================================

                        if not exist venv (
                            echo Creating virtual environment...
                            "%PYTHON%" -m venv venv

                            if %ERRORLEVEL% NEQ 0 (
                                echo Failed to create virtual environment.
                                exit /b 1
                            )
                        )

                        echo Upgrading pip...
                        venv\\Scripts\\python.exe -m pip install --upgrade pip

                        if %ERRORLEVEL% NEQ 0 (
                            echo Pip upgrade failed.
                            exit /b 1
                        )

                        echo Installing requirements...
                        venv\\Scripts\\python.exe -m pip install -r requirements.txt

                        if %ERRORLEVEL% NEQ 0 (
                            echo Requirements installation failed.
                            exit /b 1
                        )

                        echo Python setup completed successfully.
                    '''
                }
            }
        }

        stage('Lint / Basic Checks') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==========================================
                        echo LINT CHECK
                        echo ==========================================

                        venv\\Scripts\\python.exe -m pip install flake8

                        venv\\Scripts\\python.exe -m flake8 . --max-line-length=120 --exclude=venv

                        if %ERRORLEVEL% NEQ 0 (
                            echo Flake8 found warnings/errors.
                            echo Continuing because lint is non-blocking.
                            exit /b 0
                        }

                        echo Lint check completed successfully.
                    '''
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==========================================
                        echo RUNNING TESTS
                        echo ==========================================

                        venv\\Scripts\\python.exe -m pip install pytest

                        venv\\Scripts\\python.exe -m pytest

                        if %ERRORLEVEL% NEQ 0 (
                            echo No tests found or tests failed.
                            echo Continuing because tests are currently non-blocking.
                            exit /b 0
                        }

                        echo Tests completed successfully.
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==========================================
                        echo BUILDING DOCKER IMAGE
                        echo ==========================================

                        docker build ^
                            -t %DOCKER_IMAGE%:%BUILD_NUMBER% ^
                            -t %DOCKER_IMAGE%:latest ^
                            .

                        if %ERRORLEVEL% NEQ 0 (
                            echo Docker image build failed.
                            exit /b 1
                        )

                        echo DOCKER IMAGE BUILT SUCCESSFULLY
                    '''
                }
            }
        }

        stage('Login to DockerHub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    bat '''
                        echo ==========================================
                        echo DOCKER HUB LOGIN
                        echo ==========================================

                        echo %DOCKER_PASSWORD% | docker login ^
                            -u %DOCKER_USERNAME% ^
                            --password-stdin

                        if %ERRORLEVEL% NEQ 0 (
                            echo Docker Hub login failed.
                            echo Please check Jenkins credential:
                            echo dockerhub-credentials
                            exit /b 1
                        )

                        echo Docker Hub login successful.
                    '''
                }
            }
        }

        stage('Push to DockerHub') {
            steps {
                bat '''
                    echo ==========================================
                    echo PUSHING DOCKER IMAGE
                    echo ==========================================

                    docker push %DOCKER_IMAGE%:%BUILD_NUMBER%

                    if %ERRORLEVEL% NEQ 0 (
                        echo Version image push failed.
                        exit /b 1
                    )

                    docker push %DOCKER_IMAGE%:latest

                    if %ERRORLEVEL% NEQ 0 (
                        echo Latest image push failed.
                        exit /b 1
                    )

                    echo DOCKER PUSH COMPLETED
                '''
            }
        }

        stage('Deploy') {
            steps {
                dir('AI_Recipe_Generator') {
                    bat '''
                        echo ==========================================
                        echo DEPLOYING APPLICATION
                        echo ==========================================

                        echo Stopping old container...
                        docker stop %APP_NAME% >nul 2>&1

                        echo Removing old container...
                        docker rm %APP_NAME% >nul 2>&1

                        echo Starting new container...

                        docker run -d ^
                            --name %APP_NAME% ^
                            -p %HOST_PORT%:%APP_PORT% ^
                            %DOCKER_IMAGE%:%BUILD_NUMBER%

                        if %ERRORLEVEL% NEQ 0 (
                            echo Docker container failed to start.
                            exit /b 1
                        )

                        echo ==========================================
                        echo APPLICATION DEPLOYED SUCCESSFULLY
                        echo ==========================================

                        docker ps --filter "name=%APP_NAME%"

                        echo Application URL:
                        echo http://localhost:%HOST_PORT%
                    '''
                }
            }
        }
    }

    post {
        success {
            echo """
==========================================
       PIPELINE SUCCESSFUL
==========================================

Project:
AI Recipe Generator

Build Number:
${env.BUILD_NUMBER}

Docker Image:
${env.DOCKER_IMAGE}:${env.BUILD_NUMBER}

Latest Image:
${env.DOCKER_IMAGE}:latest

Application:
http://localhost:5000

==========================================
"""
        }

        failure {
            echo """
==========================================
         PIPELINE FAILED
==========================================

Build Number:
${env.BUILD_NUMBER}

Check the failed stage above.

==========================================
"""
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}
```
